# ---------------------------------------------------------------------------
# QuvnoqTest.uz environment. EVERYTHING below is optional for local demo mode:
# without Supabase the app stores users/progress in a signed cookie (per-device).
# ---------------------------------------------------------------------------

# --- Database / auth / storage (Supabase, free tier) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the demo-mode cookie session (set any long random string)
SESSION_SECRET=please-change-me-to-a-long-random-string

# --- AI tutor (Anthropic) — server-side only, never exposed to the client ---
ANTHROPIC_API_KEY=
# SRS names claude-haiku-4-5; the dated string is the exact current model id.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Read-aloud TTS (Google Gemini) — used ONLY by `npm run seed:tts` ---
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Charon

# --- Magic-link email delivery (optional; Resend) ---
# Without it: in cookie demo mode the link is shown directly in the UI (same
# device only); in Supabase mode sending is disabled with a friendly message.
RESEND_API_KEY=
MAGIC_LINK_FROM="QuvnoqTest <login@quvnoqtest.uz>"

# Public base URL (used to build magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
