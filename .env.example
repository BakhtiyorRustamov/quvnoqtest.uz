# ---------------------------------------------------------------------------
# QuvnoqTest.uz environment TEMPLATE. Copy to `.env` and fill in real values.
# `.env` is gitignored; THIS file must contain placeholders only — never secrets.
# Everything below is optional for local demo mode: without Supabase the app
# stores users/progress in a signed cookie (per-device).
# ---------------------------------------------------------------------------

# --- Database / auth / storage (Supabase, free tier) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_DATABASE_PASSWORD=your-db-password

# Secret used to sign the demo-mode cookie session (any long random string)
SESSION_SECRET=please-change-me-to-a-long-random-string

# --- AI tutor — pick ONE OpenAI-compatible backend (server-side only) ---
# Groq (free):   https://api.groq.com/openai/v1   model llama-3.3-70b-versatile
# OpenAI:        https://api.openai.com/v1         model gpt-4o-mini
# Ollama (local) http://localhost:11434/v1         model llama3.2  (no key)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=your-ai-api-key
# Azure OpenAI alternative (if used instead of AI_* above):
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Read-aloud TTS — used ONLY by `npm run seed:tts` (never at runtime) ---
# Math lessons (g1-math…) → Azure AI Speech (Uzbek voice). Kept as-is to save $.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
# Uzbek voices: uz-UZ-SardorNeural (male) or uz-UZ-MadinaNeural (female)
AZURE_SPEECH_VOICE=uz-UZ-SardorNeural
# Optional: region (e.g. eastus) used instead of the endpoint
# AZURE_SPEECH_REGION=
#
# Ona tili lessons (g1-ona…) → Google Gemini TTS (model gemini-3.1-flash-tts-preview,
# voice Charon) via Vertex AI. Auth = a service-account key file named `gcloud-tts.json`
# placed in the PROJECT ROOT (C:\Users\user\q). The seed script auto-detects it and
# reads the project id FROM the key — so nothing below is required. See scripts/TTS_SETUP.md.
# Optional overrides (defaults shown):
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Charon
# GEMINI_TTS_LOCATION=global          # try us-central1 if 'global' rejects the model
# GOOGLE_CLOUD_PROJECT=               # only needed if you DON'T use a key file (ADC path)
# GEMINI_API_KEY=                     # set ONLY to use the Gemini API-key path instead

# --- Magic-link email delivery (optional; Resend) ---
RESEND_API_KEY=
MAGIC_LINK_FROM="QuvnoqTest <login@quvnoqtest.uz>"

# Public base URL (used to build magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Telegram bot (parents' mini app + weekly reports / reminders) ---
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
# Protects /api/telegram/cron; set the same value in Vercel env
CRON_SECRET=any-long-random-string

# --- Admin panel (/admin) ---
# scrypt hash of your admin password. Generate with:
#   node scripts/hash-admin-password.mjs "your-password-here"
# The plaintext password is never stored anywhere.
ADMIN_PASSWORD_HASH=

# Your personal Telegram numeric user ID. Receives duplicate/low-score alerts
# and the 09:00 daily money digest through the same bot as TELEGRAM_BOT_TOKEN.
# Get it from @userinfobot. You must /start the bot once so it can message you.
ADMIN_TELEGRAM_ID=
