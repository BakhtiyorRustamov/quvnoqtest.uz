      "prompt": {
        "uz": "Bloklardan 63 sonini yasa!",
        "ru": "Собери число 63 из блоков!",
        "en": "Build the number 63 from blocks!"
      },
      "hint": {
        "uz": "6 ta oʻnlik (+10) va 3 ta birlik (+1).",
        "ru": "6 десятков (+10) и 3 единиц (+1).",
        "en": "6 tens (+10) and 3 ones (+1)."
      },
      "explanation": {
        "uz": "63 = 60 + 3: 6 oʻnlik va 3 birlik.",
        "ru": "63 = 60 + 3: 6 десятков и 3 единиц.",
        "en": "63 = 60 + 3: 6 tens and 3 ones."
      }
