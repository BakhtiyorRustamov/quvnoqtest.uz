  "title": {
    "uz": "Taqqoslashga doir masalalar",
    "ru": "Задачи на сравнение",
    "en": "Comparison problems"
  },
  "recall": {
    "uz": "Taqqoslashda qaysi son katta ekanini topamiz va ular qancha farq qilishini ayirish bilan aniqlaymiz. Masalan, 10 ta mashina va 7 ta tank — mashina 10 - 7 = 3 ta koʻp.",
    "ru": "При сравнении находим, какое число больше, и насколько — с помощью вычитания. Например, 10 машин и 7 танков — машин на 10 - 7 = 3 больше.",
    "en": "When comparing we find which is bigger and by how much, using subtraction. For example 10 vehicles and 7 tanks — vehicles are 10 - 7 = 3 more."
  },
  "items": [
    {
      "id": "q1",
      "type": "widget",
      "visualHint": "none",
      "media": {
        "gif": "/quiz-media/compare-diff.gif",
        "alt": {
          "uz": "Qancha koʻp? Farqni topamiz",
          "ru": "Насколько больше? Находим разность",
          "en": "How many more? We find the difference"
        },
        "maxWidth": 230
      },
      "widget": {
        "type": "mcq",
        "props": {
          "choices": [
            "3",
            "2",
            "4"
          ],
          "answerIndex": 0
        }
      },
      "prompt": {
        "uz": "Namoyishda 7 ta tank va 10 ta harbiy mashina. Mashina qancha koʻp?",
        "ru": "На параде 7 танков и 10 машин. Насколько машин больше?",
        "en": "A parade had 7 tanks and 10 vehicles. How many more vehicles?"
      },
      "hint": {
        "uz": "10 dan 7 ni ayir.",
        "ru": "Вычти из 10 число 7.",
        "en": "Take 7 from 10."
      },
      "explanation": {
        "uz": "10 - 7 = 3.",
        "ru": "10 - 7 = 3.",
        "en": "10 - 7 = 3."
      }
    },
