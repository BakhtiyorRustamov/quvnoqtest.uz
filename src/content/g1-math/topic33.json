    { "id": "q4", "type": "widget", "visualHint": "none", "widget": { "type": "mcq", "props": { "choices": ["-", "+"], "answerIndex": 0 } },
      "prompt": { "uz": "Toʻgʻri belgini qoʻy: 7 ? 2 = 5", "ru": "Поставь верный знак: 7 ? 2 = 5", "en": "Put the right sign: 7 ? 2 = 5" },
      "hint": { "uz": "Natija kichraydimi yoki kattalashdimi?", "ru": "Результат уменьшился или увеличился?", "en": "Did the result get smaller or bigger?" },
      "explanation": { "uz": "Yetti ayirish ikki — besh. Ayirish belgisi kerak.", "ru": "Семь минус два — пять. Нужен знак вычитания.", "en": "Seven minus two is five. The minus sign is needed." } },
    { "id": "q5", "type": "widget", "visualHint": "none", "widget": { "type": "mcq", "props": { "choices": ["0", "1", "6"], "answerIndex": 0 } },
      "prompt": { "uz": "Ayirmani top: 6 - 6 = ?", "ru": "Найди разность: 6 - 6 = ?", "en": "Find the difference: 6 - 6 = ?" },
