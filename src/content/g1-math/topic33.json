    { "id": "q3", "type": "widget", "visualHint": "none", "widget": { "type": "mcq", "props": { "choices": ["5", "6", "4"], "answerIndex": 0 } },
      "prompt": { "uz": "Ayirmani top: 8 - 3 = ?", "ru": "Найди разность: 8 - 3 = ?", "en": "Find the difference: 8 - 3 = ?" },
