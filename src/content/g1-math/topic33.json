      "prompt": { "uz": "Qaysi ayirma katta: 9-2 yoki 8-4?", "ru": "Какая разность больше: 9-2 или 8-4?", "en": "Which difference is bigger: 9-2 or 8-4?" },
      "hint": { "uz": "Ikkala ayirmani hisobla, soʻng solishtir.", "ru": "Посчитай обе разности, потом сравни.", "en": "Work out both differences, then compare." },
      "explanation": { "uz": "Toʻqqiz ayirish ikki — yetti; sakkiz ayirish toʻrt — toʻrt. Yetti kattaroq.", "ru": "Девять минус два — семь; восемь минус четыре — четыре. Семь больше.", "en": "Nine minus two is seven; eight minus four is four. Seven is bigger." } },
