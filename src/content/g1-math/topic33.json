      "explanation": { "uz": "Olti ayirish olti — ayirma nol.", "ru": "Шесть минус шесть — разность ноль.", "en": "Six minus six — the difference is zero." } },
    { "id": "q6", "type": "widget", "visualHint": "none", "widget": { "type": "mcq", "props": { "choices": ["3", "2", "4"], "answerIndex": 0 } },
      "prompt": { "uz": "Kamayuvchi 8, ayirma 5. Ayriluvchi nechа?", "ru": "Уменьшаемое 8, разность 5. Чему равно вычитаемое?", "en": "Minuend 8, difference 5. What is the subtrahend?" },
      "hint": { "uz": "Sakkizdan nechtasini ayirsak, besh qoladi?", "ru": "Сколько вычесть из восьми, чтобы вышло пять?", "en": "How much to take from eight to leave five?" },
      "explanation": { "uz": "Sakkiz ayirish uch — besh. Ayriluvchi — uch.", "ru": "Восемь минус три — пять. Вычитаемое — три.", "en": "Eight minus three is five. The subtrahend is three." } },
    { "id": "q7", "type": "widget", "visualHint": "none", "widget": { "type": "mcq", "props": { "choices": ["3", "4", "2"], "answerIndex": 0 } },
      "prompt": { "uz": "Ayirmani top: 10 - 7 = ?", "ru": "Найди разность: 10 - 7 = ?", "en": "Find the difference: 10 - 7 = ?" },
