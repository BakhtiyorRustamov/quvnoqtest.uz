  "items": [
    { "id": "q1", "type": "widget", "visualHint": "none", "widget": { "type": "mcq", "props": { "choices": ["5", "4", "6"], "answerIndex": 0 } },
      "prompt": { "uz": "Ayirmani top: 9 - 4 = ?", "ru": "Найди разность: 9 - 4 = ?", "en": "Find the difference: 9 - 4 = ?" },
      "hint": { "uz": "Toʻqqiztadan toʻrttasini olib tashla.", "ru": "Убери от девяти четыре.", "en": "Take four away from nine." },
      "explanation": { "uz": "Toʻqqiz ayirish toʻrt — ayirma besh.", "ru": "Девять минус четыре — разность пять.", "en": "Nine minus four — the difference is five." } },
    { "id": "q2", "type": "widget", "visualHint": "none", "widget": { "type": "mcq", "props": { "choices": ["4", "3", "5"], "answerIndex": 0 } },
      "prompt": { "uz": "Kamayuvchi 10, ayriluvchi 6. Ayirma nechа?", "ru": "Уменьшаемое 10, вычитаемое 6. Чему равна разность?", "en": "Minuend 10, subtrahend 6. What is the difference?" },
