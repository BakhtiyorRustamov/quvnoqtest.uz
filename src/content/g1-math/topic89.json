  "emojis": "📏➖✨",
  "title": {
    "uz": "Qancha ortiq, qancha kam?",
    "ru": "Насколько больше, насколько меньше?",
    "en": "How much more, how much fewer?"
  },
  "recall": {
    "uz": "«Qancha ortiq?» yoki «qancha kam?» degan savolga javob berish uchun katta sondan kichik sonni ayiramiz — bu ularning farqi. Masalan, 10 soni 7 dan 10 - 7 = 3 ta ortiq.",
    "ru": "Чтобы ответить «насколько больше?» или «насколько меньше?», из большего числа вычитаем меньшее — это их разность. Например, 10 больше 7 на 10 - 7 = 3.",
    "en": "To answer «how much more?» or «how much fewer?» we subtract the smaller from the bigger — that is their difference. For example 10 is 10 - 7 = 3 more than 7."
  },
  "items": [
    {
      "id": "q1",
      "type": "widget",
      "visualHint": "none",
      "media": {
        "gif": "/quiz-media/compare-diff.gif",
        "alt": {
          "uz": "Qancha koʻp? Farqni topamiz",
          "ru": "Насколько больше? Находим разность",
          "en": "How many more? We find the difference"
        },
        "maxWidth": 230
      },
      "widget": {
        "type": "mcq",
        "props": {
          "choices": [
            "3",
            "2",
            "4"
          ],
          "answerIndex": 0
        }
      },
      "prompt": {
        "uz": "Bir qatorda 10 ta, boshqasida 7 ta mashina. Birinchisida qancha koʻp?",
        "ru": "В одном ряду 10 машин, в другом 7. Насколько в первом больше?",
        "en": "One row has 10 cars, another 7. How many more in the first?"
      },
      "hint": {
        "uz": "10 dan 7 ni ayir.",
        "ru": "Вычти из 10 число 7.",
        "en": "Take 7 from 10."
      },
      "explanation": {
        "uz": "10 - 7 = 3.",
        "ru": "10 - 7 = 3.",
        "en": "10 - 7 = 3."
      }
    },
