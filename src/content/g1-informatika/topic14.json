      "type": "widget",
      "visualHint": "none",
      "prompt": {
        "uz": "Choy damlash tartibini joyla!",
        "ru": "Порядок заваривания чая!",
        "en": "Order the tea-brewing steps!"
      },
      "hint": {
        "uz": "Chayamiz, choy solamiz, suv quyamiz.",
        "ru": "Ополоснуть, засыпать, залить.",
        "en": "Rinse, add tea, pour water."
      },
      "explanation": {
        "uz": "Toʻgʻri tartib!",
        "ru": "Верный порядок!",
        "en": "Correct order!"
      },
      "widget": {
        "type": "story_sequence",
        "props": {
          "events": [
            {
              "text": {
                "uz": "Choynakni issiq suvda chaymiz.",
                "ru": "Ополаскиваем чайник.",
                "en": "We rinse the teapot."
              }
            },
            {
              "text": {
                "uz": "Choynakka quruq choy solamiz.",
                "ru": "Засыпаем сухой чай.",
                "en": "We add dry tea."
              }
            },
            {
              "text": {
                "uz": "Ustiga qaynagan suv quyamiz.",
                "ru": "Заливаем кипятком.",
                "en": "We pour boiling water."
              }
            },
            {
              "text": {
                "uz": "5 daqiqa damlaymiz.",
                "ru": "Настаиваем 5 минут.",
                "en": "We let it brew 5 minutes."
              }
            }
          ]
        }
      }
    },
