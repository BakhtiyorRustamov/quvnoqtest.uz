      "type": "widget",
      "visualHint": "none",
      "prompt": {
        "uz": "Suhbatni tingla. Bolaning ismi nima?",
        "ru": "Послушай диалог. Как зовут мальчика?",
        "en": "Listen to the dialog. What is the boy's name?"
      },
      "hint": {
        "uz": "«I'm …» — «Men …man» degani. Bola oʻz ismini aytadi.",
        "ru": "«I'm …» значит «Я — …». Мальчик называет своё имя.",
        "en": "\"I'm …\" means \"My name is …\". The boy says his own name."
      },
      "explanation": {
        "uz": "Barakalla! Bola «I'm Sam» dedi — uning ismi Sam.",
        "ru": "Молодец! Мальчик сказал «I'm Sam» — его зовут Сэм.",
        "en": "Great! The boy said \"I'm Sam\" — his name is Sam."
      },
      "widget": {
        "type": "dialog_listen",
        "props": {
          "lines": [
            {
              "who": "👧",
              "name": "Mia",
              "text": "Hello! I'm Mia. What's your name?",
              "audio": {
                "key": "ing01-q1-a",
                "text": "Hello! I'm Mia. What's your name?",
                "voice": "girl"
              }
            },
            {
              "who": "👦",
              "name": "Sam",
              "text": "Hi! I'm Sam!",
              "audio": {
                "key": "ing01-q1-b",
                "text": "Hi! I'm Sam!",
                "voice": "boy"
