        "en": "Listen and tap what the children found!"
      },
      "audio": {
        "key": "ing03-q3",
        "text": "Look! It's a treehouse!",
        "voice": "boy"
      },
      "hint": {
        "uz": "«Treehouse» — daraxtdagi uycha.",
        "ru": "«Treehouse» — домик на дереве.",
        "en": "\"Tree\" + \"house\" — a house in a tree."
      },
      "explanation": {
        "uz": "Toʻgʻri! Treehouse — daraxt uycha.",
        "ru": "Верно! Treehouse — домик на дереве.",
        "en": "Right! A treehouse!"
      },
      "widget": {
        "type": "pick_picture",
        "props": {
          "options": [
            {
              "emoji": "🌳",
              "label": {
                "uz": "daraxt uycha",
