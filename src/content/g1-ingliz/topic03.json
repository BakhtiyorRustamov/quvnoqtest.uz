            }
          ]
        }
      }
    },
    {
      "id": "q5",
      "type": "widget",
      "visualHint": "none",
      "prompt": {
        "uz": "Toʻgʻri yoki notoʻgʻri: qiziquvchan bola yangi narsalarni kashf qiladi.",
        "ru": "Верно или неверно: любознательный ребёнок открывает новое.",
        "en": "True or false: a curious child discovers new things."
      },
      "hint": {
        "uz": "Sam qiziqdi — va uycha topildi!",
        "ru": "Сэм полюбопытствовал — и нашёлся домик!",
        "en": "Sam was curious — and found the treehouse!"
      },
      "explanation": {
        "uz": "Toʻgʻri! Qiziquvchanlik yangi kashfiyotlarga olib boradi.",
        "ru": "Верно! Любознательность ведёт к открытиям.",
        "en": "True! Curiosity leads to discoveries."
      },
      "widget": {
        "type": "true_false",
        "props": {
          "emoji": "🔭",
          "answer": true
        }
      }
    },
    {
