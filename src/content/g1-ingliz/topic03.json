{
  "topicId": "g1-ingliz-03",
  "subjectKey": "g1-ingliz",
  "emojis": "🔭🌳🏡✨",
  "title": {
    "uz": "Qiziquvchan boʻl! (hikoya)",
    "ru": "Будь любознательным! (история)",
    "en": "Be curious! (story)"
  },
  "recall": {
    "uz": "Hikoya vaqti! Bolalar hovlida oʻynab, ajoyib narsa topib olishadi. Qiziquvchan boʻl!",
    "ru": "Время истории! Дети играют во дворе и находят кое-что чудесное. Будь любознательным!",
    "en": "Story time! Three friends find something amazing. Be curious!"
  },
  "ttsText": {
    "uz": "Qiziquvchan boʻl! Hikoya.",
    "en": "Story time! Three friends find something amazing. Be curious!"
  },
  "recallAudioLang": "en",
  "recallMedia": {
    "gif": "/quiz-media/en-curious.gif",
    "maxWidth": 260
  },
  "items": [
    {
      "id": "q1",
      "type": "widget",
      "visualHint": "none",
      "prompt": {
        "uz": "Hikoyani tingla!",
        "ru": "Послушай историю!",
        "en": "Listen to the story!"
      },
      "hint": {
        "uz": "Har bir gapni diqqat bilan tingla, keyin savollar boʻladi.",
        "ru": "Слушай внимательно — потом будут вопросы.",
        "en": "Listen carefully — questions come next."
      },
      "explanation": {
        "uz": "Barakalla! Endi savollarga tayyorsan.",
        "ru": "Молодец! Теперь ты готов к вопросам.",
        "en": "Great! Now you're ready for the questions."
      },
      "widget": {
        "type": "dialog_listen",
        "props": {
          "lines": [
            {
              "who": "👩‍🏫",
              "name": "Narrator",
              "text": "Mia, Sam and Zara play in the yard.",
              "audio": {
                "key": "ing03-q1-a",
                "text": "Mia, Sam and Zara play in the yard.",
                "voice": "teacher"
              }
            },
            {
              "who": "👦",
              "name": "Sam",
              "text": "Wow! Look! Come here!",
              "audio": {
                "key": "ing03-q1-b",
                "text": "Wow! Look! Come here!",
                "voice": "boy"
              }
            },
            {
              "who": "👧",
              "name": "Mia",
              "text": "What is it?",
              "audio": {
                "key": "ing03-q1-c",
                "text": "What is it?",
                "voice": "girl"
              }
            },
            {
              "who": "👦",
              "name": "Sam",
              "text": "It's a treehouse!",
              "audio": {
                "key": "ing03-q1-d",
                "text": "It's a treehouse!",
                "voice": "boy"
              }
            }
          ],
          "question": {
            "prompt": {
              "uz": "Bolalar nimani koʻrishdi?",
              "ru": "Что увидели дети?",
              "en": "What did the children see?"
            },
            "choices": [
              {
                "uz": "Daraxt uycha",
                "ru": "Домик на дереве",
                "en": "A treehouse"
              },
              {
                "uz": "Mushuk",
                "ru": "Кошку",
                "en": "A cat"
              },
              {
                "uz": "Mashina",
                "ru": "Машину",
                "en": "A car"
              }
            ],
            "answerIndex": 0
          }
        }
      }
    },
    {
      "id": "q2",
      "type": "widget",
      "visualHint": "none",
      "prompt": {
        "uz": "Voqealarni roʻy bergan tartibida bos!",
        "ru": "Нажимай события по порядку!",
        "en": "Tap the story events in order!"
      },
      "hint": {
        "uz": "Avval oʻyin, keyin topilma, oxirida uychada oʻynash.",
        "ru": "Сначала игра, потом находка, в конце — игра в домике.",
        "en": "First playing, then the discovery, then playing inside."
      },
      "explanation": {
        "uz": "Barakalla! Hikoyani yaxshi eslab qolding!",
        "ru": "Молодец! Ты хорошо запомнил историю!",
        "en": "Great! You remembered the story well!"
      },
      "widget": {
        "type": "story_sequence",
        "props": {
          "emoji": "🌳",
          "events": [
            {
              "text": {
                "uz": "Bolalar hovlida oʻynashdi.",
                "ru": "Дети играли во дворе.",
                "en": "The children played in the yard."
              }
            },
            {
              "text": {
                "uz": "Sam daraxt orqasida nimadir koʻrdi.",
                "ru": "Сэм что-то заметил за деревом.",
                "en": "Sam noticed something behind the tree."
              }
            },
            {
              "text": {
                "uz": "Ular daraxtdagi uychani topishdi.",
                "ru": "Они нашли домик на дереве.",
                "en": "They found a treehouse."
              }
            },
            {
              "text": {
                "uz": "Doʻstlar yuqoriga chiqib, birga oʻynashdi.",
                "ru": "Друзья забрались наверх и играли вместе.",
                "en": "The friends climbed up and played together."
              }
            }
          ]
        }
      }
    },
    {
      "id": "q3",
      "type": "widget",
      "visualHint": "none",
      "prompt": {
        "uz": "Tingla va bolalar topgan narsani bos!",
