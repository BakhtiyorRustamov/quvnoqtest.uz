    {
      "id": "q4",
      "type": "widget",
      "visualHint": "none",
      "prompt": {
        "uz": "«Look!» soʻzi nima degani? Tingla va bos!",
        "ru": "Что значит «Look!»? Послушай и нажми!",
        "en": "What does \"Look!\" mean? Listen and tap!"
      },
      "audio": {
        "key": "ing03-q4",
        "text": "Look! Look!",
        "voice": "teacher"
      },
      "hint": {
        "uz": "Buni aytganda qoʻl bilan koʻrsatamiz.",
        "ru": "Говоря это, мы показываем рукой.",
        "en": "You use your eyes for this."
      },
      "explanation": {
        "uz": "Barakalla! «Look!» — «Qara!» degani, koʻz bilan qaraymiz.",
        "ru": "Молодец! «Look!» значит «Смотри!» — смотрим глазами.",
        "en": "Great! \"Look!\" means to use your eyes."
      },
      "widget": {
        "type": "pick_picture",
        "props": {
          "options": [
            {
              "emoji": "👀",
              "label": {
                "uz": "qarash",
                "ru": "смотреть",
